      "line_index": 0,
      "speaker": "萧瑟",
      "line": "在此候着。",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D02",
      "scene_id": "CH01-S01",
      "line_index": 1,
      "speaker": "连忙",
      "line": "你迟到了。",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D03",
      "scene_id": "CH01-S01",
      "line_index": 2,
      "speaker": "林雪衣",
      "line": "路上遇到了几个不长眼的毛贼。",
      "quote_style": "double",
      "parenthetical": "抱拳",
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D04",
      "scene_id": "CH01-S01",
      "line_index": 3,
      "speaker": "林雪衣",
      "line": "不长眼？怕是你故意放走的吧。",
      "quote_style": "single",
      "parenthetical": "抱拳",
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D05",
      "scene_id": "CH01-S01",
      "line_index": 4,
      "speaker": "萧尘",
      "line": "这是你要的东西。不过——",
      "quote_style": "double",
      "parenthetical": "抱拳",
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D06",
      "scene_id": "CH01-S01",
      "line_index": 5,
      "speaker": "萧尘",
      "line": "——看完之后，你我两清。",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D07",
      "scene_id": "CH01-S01",
      "line_index": 6,
      "speaker": "林雪衣",
      "line": "朝廷派了七十二暗卫。",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D08",
      "scene_id": "CH01-S01",
      "line_index": 7,
      "speaker": "萧尘入",
      "line": "你若要去京城，最好绕道潼关。",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D09",
      "scene_id": "CH01-S01",
      "line_index": 8,
      "speaker": "萧尘入",
      "line": "绕道？",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S01-D10",
      "scene_id": "CH01-S01",
      "line_index": 9,
      "speaker": "林雪衣",
      "line": "我萧尘入江湖，就没打算绕道。",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S02-D01",
      "scene_id": "CH01-S02",
      "line_index": 0,
      "speaker": "萧尘",
      "line": "出来。",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    },
    {
      "dialogue_id": "CH01-S02-D02",
      "scene_id": "CH01-S02",
      "line_index": 1,
      "speaker": "萧尘",
      "line": "少主，属下暗十七，奉夫人之命前来接应。",
      "quote_style": "double",
      "parenthetical": null,
      "confidence": 0.5,
      "attribution_method": "nearest_name"
    }
  ]
